{
  "name": "@react-spa-scaffold/electron",
  "version": "0.1.0",
  "description": "Electron desktop wrapper for react-spa-scaffold",
  "type": "module",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- electron-forge start",
    "build": "dotenv -e ../../.env -- electron-forge package",
    "make": "dotenv -e ../../.env -- electron-forge make",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-dmg": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@lingui/vite-plugin": "^5.7.0",
    "@react-spa-scaffold/tsconfig": "*",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.2",
    "dotenv-cli": "^11.0.0",
    "electron": "^39.2.7",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}

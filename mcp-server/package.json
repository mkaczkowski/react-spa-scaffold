{
  "name": "@anthropic/webapp-base-mcp",
  "version": "1.0.0",
  "description": "MCP server for scaffolding projects based on webapp-base template",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "webapp-base-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @anthropic-ai/mcp-inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "webapp-base",
    "scaffolding",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
